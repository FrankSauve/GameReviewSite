# Production environment for docker-compose.prod.yml
# Copy to .env on the server and fill in every value.
#
#   cp .env.prod.example .env

# ── Required ─────────────────────────────────────────────────────────────────

# PostgreSQL password. Generate one: openssl rand -hex 24
POSTGRES_PASSWORD=

# RAWG game database API key — https://rawg.io/apidocs
RAWG_API_KEY=

# Shared secret proving a request came through the authentik-protected proxy.
# Must match the X-Proxy-Secret literal in the SWAG proxy conf exactly.
# Generate one: openssl rand -hex 32
AUTH_PROXY_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────

# Name of the existing docker network SWAG runs on.
# PROXY_NETWORK=swag

# Number of reverse proxies in front of the backend. 1 for SWAG proxying
# straight to it. Wrong values make rate limiting key on the proxy's IP, so a
# single abusive client locks out everyone.
# TRUST_PROXY_HOPS=1

# POSTGRES_DB=gamereview
# POSTGRES_USER=gamereview
