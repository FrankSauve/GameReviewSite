# Root .env — used by docker-compose
# Copy to .env and fill in the values

# RAWG game database API key — https://rawg.io/apidocs
RAWG_API_KEY=your-rawg-api-key-here

# Shared secret proving a request came through the authentik-protected reverse
# proxy. Required once the stack runs behind the proxy.
# Generate one with: openssl rand -hex 32
AUTH_PROXY_SECRET=

# ── Local development ────────────────────────────────────────────────────────

# There is no authentik outpost in front of the local stack, so without this
# every request is anonymous and all mutations fail. Ignored in production.
# Format: uid:username:email
AUTH_DEV_IDENTITY=dev-uid:devuser:dev@example.com

# ── Optional overrides ───────────────────────────────────────────────────────

# Browser origins allowed to call the API (comma-separated).
# Defaults to http://localhost:3000 for the local stack.
# CORS_ORIGINS=http://localhost:3000

# Number of reverse proxies in front of the backend. Must be exact, or rate
# limiting keys on the proxy IP instead of the client IP.
# TRUST_PROXY_HOPS=0
