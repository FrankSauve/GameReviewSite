# Root .env — used by docker-compose
# Copy to .env and fill in the values

# JWT secret — use a long random string in production
# Generate one with: openssl rand -hex 64
JWT_SECRET=change-me-to-a-long-random-string

# RAWG game database API key — https://rawg.io/apidocs
RAWG_API_KEY=your-rawg-api-key-here

# ── Optional overrides ───────────────────────────────────────────────────────

# Browser origins allowed to call the API (comma-separated).
# Defaults to http://localhost:3000 for the local stack.
# CORS_ORIGINS=http://localhost:3000

# Number of reverse proxies in front of the backend. Must be exact, or rate
# limiting keys on the proxy IP instead of the client IP.
# TRUST_PROXY_HOPS=0
