# Root .env — used by docker-compose
# Copy to .env and fill in the values

# RAWG game database API key — https://rawg.io/apidocs
RAWG_API_KEY=your-rawg-api-key-here

# ── Local development ────────────────────────────────────────────────────────

# There is no identity provider in front of the local stack, so without this
# every request is anonymous and all mutations fail. Ignored in production.
# Format: uid:username:email
#
# Unset it to browse locally as an anonymous visitor. It applies to every
# request now that there is a single GraphQL endpoint.
AUTH_DEV_IDENTITY=dev-uid:devuser:dev@example.com

# ── OIDC: how sign-in works in production ────────────────────────────────────
#
# This app is the OAuth2 client, not a passenger behind a proxy that
# authenticates for it. In production all four are required and the backend
# refuses to start without them. See docs/authentik-setup.md for where each
# value comes from in the authentik admin UI.
#
# Locally they are optional: AUTH_DEV_IDENTITY covers sign-in. Setting them
# does not fully work with the default local topology, because the SPA is on
# :3000 and the API on :4000 while the /auth routes are same-origin.
#
# OIDC_ISSUER=https://authentik.example.com/application/o/gamereviews/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://gamereviews.example.com/auth/callback

# Optional. Where authentik sends the browser after signing out. Must also be
# registered as a redirect URI on the provider, so it is left unset by default —
# an unregistered value breaks logout.
# OIDC_POST_LOGOUT_REDIRECT_URI=https://gamereviews.example.com/

# ── Optional overrides ───────────────────────────────────────────────────────

# How long a session lasts. Defaults to 720 (30 days), matching authentik's own
# session length. Revoking someone in authentik does not end a session already
# issued here, so this is the upper bound on that lag.
# SESSION_TTL_HOURS=720

# Browser origins allowed to call the API (comma-separated).
# Defaults to http://localhost:3000 for the local stack.
# CORS_ORIGINS=http://localhost:3000

# Number of reverse proxies in front of the backend. Must be exact, or rate
# limiting keys on the proxy IP instead of the client IP.
# TRUST_PROXY_HOPS=0

# Sign-in attempts allowed per minute, per IP. Defaults to 20.
# AUTH_RATE_LIMIT_MAX=20
