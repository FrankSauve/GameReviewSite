generator client {
  provider = "prisma-client-js"
  // "native" resolves to the correct binary at generate time:
  //   - macOS  → darwin-arm64 / darwin-x64  (local dev)
  //   - Docker → linux-musl-openssl-3.0.x   (Alpine container)
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  // Stable subject identifier from authentik: the OIDC `sub` claim. Nullable so
  // rows created before the authentik migration can be adopted on first login.
  authentikUid String? @unique
  username  String    @unique
  email     String?   @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  reviews   Review[]
  comments  Comment[]
  addedGames Game[]   @relation("GameCreator")
  sessions  Session[]
}

/// A signed-in browser.
///
/// The backend is the OIDC client, so it issues its own session rather than
/// re-checking with authentik on every request. See lib/session.ts.
model Session {
  /// SHA-256 of the value in the cookie, never the value itself, so a dump of
  /// this table does not hand over usable sessions.
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Kept solely to pass as `id_token_hint` on RP-initiated logout, so authentik
  /// knows which session to end without prompting.
  idToken   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Game {
  id          String   @id @default(uuid())
  rawgId      String?  @unique
  /// The readable identifier this game is linked by, derived from the title at
  /// insert and never regenerated — see lib/slug.ts. Not null, so every game has
  /// a readable URL rather than a fallback to the UUID that would live forever.
  slug        String   @unique
  title       String
  genre       String?
  platform    String?
  description String?
  coverUrl    String?
  releaseYear Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Who added this game. Nullable because rows predating this column have no
  // recorded creator, and because deleting an account must not delete the games
  // it contributed — other people's reviews hang off them.
  createdById String?
  createdBy   User?    @relation("GameCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reviews     Review[]
}

model Review {
  id        String    @id @default(uuid())
  /// `<game-slug>-by-<username>`, fixed at insert. A review is the thing people
  /// paste into a chat window, so this is the slug that matters most; it keeps
  /// reading the old name after a rename on either side, which is the price of a
  /// link that does not rot.
  slug      String    @unique
  rating    Float
  content   String
  /// The year the game was played or finished, which is not the year the review
  /// was written: a backlog of reviews imported in one sitting would otherwise all
  /// read as 2026.
  ///
  /// Nullable, and required on CreateReviewInput rather than here. Every review
  /// written through the app carries one, while the row that predates this column
  /// and any importer that genuinely does not know a year stay representable. The
  /// migration backfills existing rows from createdAt.
  yearPlayed  Int?
  /// Hours spent with the game. Nullable for the same reason as yearPlayed, except
  /// that this one cannot be backfilled — nothing in the database implies it.
  hoursPlayed Float?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userId    String
  gameId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  comments  Comment[]

  /// Serves the by-year grouping on a profile, which sorts a single user's
  /// reviews by the year played.
  @@index([userId, yearPlayed])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  reviewId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}
