generator client {
  provider = "prisma-client-js"
  // "native" resolves to the correct binary at generate time:
  //   - macOS  → darwin-arm64 / darwin-x64  (local dev)
  //   - Docker → linux-musl-openssl-3.0.x   (Alpine container)
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  // Stable subject identifier from authentik: the OIDC `sub` claim. Nullable so
  // rows created before the authentik migration can be adopted on first login.
  authentikUid String? @unique
  /// Readable URL identifier, fixed at first provision. Not the username: that
  /// is authentik's to rename, and a freed username can be taken by a different
  /// account, which would quietly repoint every old profile link.
  slug      String    @unique
  username  String    @unique
  email     String?   @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  reviews   Review[]
  comments  Comment[]
  addedGames Game[]   @relation("GameCreator")
  sessions  Session[]
}

/// A signed-in browser.
///
/// The backend is the OIDC client, so it issues its own session rather than
/// re-checking with authentik on every request. See lib/session.ts.
model Session {
  /// SHA-256 of the value in the cookie, never the value itself, so a dump of
  /// this table does not hand over usable sessions.
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Kept solely to pass as `id_token_hint` on RP-initiated logout, so authentik
  /// knows which session to end without prompting.
  idToken   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Game {
  id          String   @id @default(uuid())
  rawgId      String?  @unique
  slug        String   @unique
  title       String
  /// Genres and platforms as lists rather than single values.
  ///
  /// They were one string each, and the search bar filled the platform one by
  /// joining RAWG's entire platforms array with commas — so a game like Terraria,
  /// which is on well over a dozen platforms, produced a string past the 100
  /// character limit and could not be added at all. Storing what they are, a
  /// list, is the fix; the cap is now on how many entries are kept rather than on
  /// how long the joined string happens to be.
  ///
  /// Scalar lists, not a join table: these are labels copied from RAWG for
  /// display, never queried across or deduplicated between games, so a Genre
  /// table would be ceremony for no query anybody makes.
  genres      String[]
  platforms   String[]
  description String?
  coverUrl    String?
  releaseYear Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("GameCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reviews     Review[]
}

model Review {
  id        String    @id @default(uuid())
  slug      String    @unique
  rating    Float
  content   String
  yearPlayed  Int?
  hoursPlayed Float?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userId    String
  gameId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  comments  Comment[]

  @@index([userId, yearPlayed])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  reviewId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}
