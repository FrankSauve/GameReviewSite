generator client {
  provider = "prisma-client-js"
  // "native" resolves to the correct binary at generate time:
  //   - macOS  → darwin-arm64 / darwin-x64  (local dev)
  //   - Docker → linux-musl-openssl-3.0.x   (Alpine container)
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  // Stable subject identifier from authentik: the OIDC `sub` claim. Nullable so
  // rows created before the authentik migration can be adopted on first login.
  authentikUid String? @unique
  /// Readable URL identifier, fixed at first provision. Not the username: that
  /// is authentik's to rename, and a freed username can be taken by a different
  /// account, which would quietly repoint every old profile link.
  slug      String    @unique
  username  String    @unique
  email     String?   @unique
  /// A self-written introduction, rendered as Markdown on the profile page.
  ///
  /// Unlike username and email this is not owned by authentik and has no
  /// meaning to it, so it is the one part of an account this app may edit.
  /// Nullable rather than defaulted to "": an account that has never written one
  /// and an account that has cleared it are the same thing, and both should read
  /// as absent rather than as an empty paragraph.
  bio       String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  reviews   Review[]
  comments  Comment[]
  addedGames Game[]   @relation("GameCreator")
  sessions  Session[]
  articles  Article[]
}

/// A signed-in browser.
///
/// The backend is the OIDC client, so it issues its own session rather than
/// re-checking with authentik on every request. See lib/session.ts.
model Session {
  /// SHA-256 of the value in the cookie, never the value itself, so a dump of
  /// this table does not hand over usable sessions.
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Kept solely to pass as `id_token_hint` on RP-initiated logout, so authentik
  /// knows which session to end without prompting.
  idToken   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Game {
  id          String   @id @default(uuid())
  rawgId      String?  @unique
  slug        String   @unique
  title       String
  /// Scalar lists, not a join table: labels copied from RAWG for display, never
  /// queried across or deduplicated between games.
  genres      String[]
  platforms   String[]
  description String?
  coverUrl    String?
  releaseYear Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("GameCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reviews     Review[]
}

model Review {
  id        String    @id @default(uuid())
  slug      String    @unique
  rating    Float
  content   String
  yearPlayed  Int?
  hoursPlayed Float?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userId    String
  gameId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  comments  Comment[]

  @@index([userId, yearPlayed])
}

/// A manifesto, an essay — anything that is not a review. Reached at /texts in
/// the app; named Article here because "text" is a word Postgres already owns.
model Article {
  id          String    @id @default(uuid())
  /// Derived from the title, and re-derived when the title changes: a text is
  /// its title in a way a game or a review is not. See lib/slug.ts.
  slug        String    @unique
  title       String
  content     String
  /// Null means a draft: visible to its author and to nobody else. A date rather
  /// than a boolean because the index is ordered by publication.
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([publishedAt])
  @@index([authorId])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  reviewId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}
