generator client {
  provider = "prisma-client-js"
  // "native" resolves to the correct binary at generate time:
  //   - macOS  → darwin-arm64 / darwin-x64  (local dev)
  //   - Docker → linux-musl-openssl-3.0.x   (Alpine container)
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  // Stable subject identifier from authentik: the OIDC `sub` claim. Nullable so
  // rows created before the authentik migration can be adopted on first login.
  authentikUid String? @unique
  /// Readable URL identifier, fixed at first provision. Not the username: that
  /// is authentik's to rename, and a freed username can be taken by a different
  /// account, which would quietly repoint every old profile link.
  slug      String    @unique
  username  String    @unique
  email     String?   @unique
  /// A self-written introduction, in Markdown. Null rather than "" when absent.
  bio       String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  reviews   Review[]
  comments  Comment[]
  addedGames Game[]   @relation("GameCreator")
  sessions  Session[]
  articles  Article[]
  reactions Reaction[]
}

/// A signed-in browser.
///
/// The backend is the OIDC client, so it issues its own session rather than
/// re-checking with authentik on every request. See lib/session.ts.
model Session {
  /// SHA-256 of the value in the cookie, never the value itself, so a dump of
  /// this table does not hand over usable sessions.
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Kept solely to pass as `id_token_hint` on RP-initiated logout, so authentik
  /// knows which session to end without prompting.
  idToken   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Game {
  id          String   @id @default(uuid())
  rawgId      String?  @unique
  slug        String   @unique
  title       String
  /// A scalar list, not a join table: labels copied from RAWG for display, never
  /// queried across or deduplicated between games.
  genres      String[] @default([])
  description String?
  coverUrl    String?
  releaseYear Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("GameCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reviews     Review[]
}

model Review {
  id        String    @id @default(uuid())
  slug      String    @unique
  rating    Float
  content   String
  yearPlayed  Int?
  hoursPlayed Float?
  /// The one platform this reviewer played on, from lib/platforms.ts. Null for a
  /// review whose game recorded no platform we can offer.
  platform    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userId    String
  gameId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  comments  Comment[]
  reactions Reaction[]

  @@index([userId, yearPlayed])
}

/// A manifesto, an essay — anything that is not a review. Reached at /articles
/// in the app.
model Article {
  id          String    @id @default(uuid())
  /// Derived from the title, and re-derived when the title changes: an article is
  /// its title in a way a game or a review is not. See lib/slug.ts.
  slug        String    @unique
  title       String
  content     String
  /// Null means a draft: visible to its author and to nobody else. A date rather
  /// than a boolean because the index is ordered by publication.
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([publishedAt])
  @@index([authorId])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  reviewId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reactions Reaction[]
}

/// One emoji one person put on one review or one comment.
model Reaction {
  id        String   @id @default(uuid())
  /// A single fully-qualified emoji, never free text. See lib/emoji.ts.
  emoji     String
  createdAt DateTime @default(now())
  userId    String
  /// Exactly one of these is set. Prisma cannot express that, so the migration
  /// adds `CHECK (num_nonnulls("reviewId", "commentId") = 1)` by hand.
  reviewId  String?
  commentId String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  review    Review?  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  /// Postgres treats NULLs as distinct, so neither unique constrains the rows
  /// whose column is null; the pair covers both parents given the CHECK above.
  @@unique([userId, reviewId, emoji])
  @@unique([userId, commentId, emoji])
  @@index([reviewId])
  @@index([commentId])
}
