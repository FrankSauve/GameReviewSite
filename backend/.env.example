# Copy this file to .env and fill in the values

PORT=4000
NODE_ENV=development

# PostgreSQL connection string
# For local dev: docker-compose up db  (starts postgres on localhost:5432)
# For full Docker: handled automatically by docker-compose
DATABASE_URL="postgresql://gamereview:gamereview@localhost:5432/gamereview"

# RAWG game database — get a free key at https://rawg.io/apidocs
RAWG_API_KEY="your-rawg-api-key-here"

# Shared secret proving a request came through the authentik-protected reverse
# proxy. The proxy sends it as X-Proxy-Secret; without a match the identity
# headers are ignored and the caller is anonymous.
# REQUIRED in production — the server refuses to start without it.
# Generate one with: openssl rand -hex 32
AUTH_PROXY_SECRET=""

# Local development only, and ignored when NODE_ENV=production: pretend every
# request is this user, since there is no authentik outpost in front of
# `npm run dev`. Format: uid:username:email
# AUTH_DEV_IDENTITY="dev-uid:devuser:dev@example.com"

# Comma-separated list of browser origins allowed to call the API.
# Leave empty in production: the SPA and API share a hostname, so no
# cross-origin access is needed and no CORS headers are sent.
CORS_ORIGINS=""

# Number of reverse proxies in front of this service. Must be exact, or rate
# limiting keys on the proxy IP instead of the client IP.
#   0 = direct access
#   2 = SWAG -> frontend nginx -> backend
TRUST_PROXY_HOPS=0
