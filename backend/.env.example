# Copy this file to .env and fill in the values

PORT=4000
NODE_ENV=development

# PostgreSQL connection string
# For local dev: docker-compose up db  (starts postgres on localhost:5432)
# For full Docker: handled automatically by docker-compose
DATABASE_URL="postgresql://gamereview:gamereview@localhost:5432/gamereview"

# RAWG game database — get a free key at https://rawg.io/apidocs
RAWG_API_KEY="your-rawg-api-key-here"

# This app is the OAuth2 client. All four are REQUIRED in production — the
# server refuses to start without them, because nobody could sign in.
# From the authentik provider's Protocol settings; see docs/authentik-setup.md.
# OIDC_ISSUER="https://authentik.example.com/application/o/gamereviews/"
# OIDC_CLIENT_ID=""
# OIDC_CLIENT_SECRET=""
# OIDC_REDIRECT_URI="https://gamereviews.example.com/auth/callback"

# Optional. Where authentik sends the browser after sign-out. Must also be
# registered as a redirect URI on the provider, so unset by default.
# OIDC_POST_LOGOUT_REDIRECT_URI=""

# How long a session lasts. Defaults to 720 (30 days), matching authentik.
# SESSION_TTL_HOURS=720

# Local development only, and ignored when NODE_ENV=production: pretend every
# request is this user, since there is no identity provider in front of
# `npm run dev`. Format: uid:username:email
# AUTH_DEV_IDENTITY="dev-uid:devuser:dev@example.com"

# Comma-separated list of browser origins allowed to call the API.
# Leave empty in production: the SPA and API share a hostname, so no
# cross-origin access is needed and no CORS headers are sent.
CORS_ORIGINS=""

# Number of reverse proxies in front of this service. Must be exact, or rate
# limiting keys on the proxy IP instead of the client IP.
#   0 = direct access
#   2 = SWAG -> frontend nginx -> backend
TRUST_PROXY_HOPS=0
